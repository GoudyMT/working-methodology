#!/bin/sh
# The kit source's push hold: the same armed-head stop the kit installs in every project (project/.githooks/pre-push).
# The gate itself arms nothing here (the kit source has no standards/project-adapter.md at its root, so row A27 grants
# no merge), but a head armed by hand is still held. Pushes stay the owner's by the permission rules; this only stops a push
# over a head still armed, since GitHub documents no head pin past a writer's push (rule:standing-grants).
refs=$(cat)
# A test change needs the owner's yes: a retest: commit (any case), or a non-A change to a test path; a merge counts
# only where it differs from every parent.
retests=""
while read -r lref lsha rref rsha; do
  case "$lsha" in *[!0]*) ;; *) continue ;; esac
  below=$(git ls-remote --heads "$2" 2>/dev/null | while read -r s _; do git cat-file -e "$s^{commit}" 2>/dev/null && printf '%s ' "$s"; done)
  case "$rsha" in *[!0]*) below="$below$rsha" ;; esac
  shas=$(git rev-list "$lsha" --not $below 2>&1) || { echo "Push blocked: the commits of $rref cannot be read, so a test change in them cannot be ruled out. $shas" >&2; exit 1; }
  for c in $shas; do
    if git rev-parse -q --verify "$c^2" >/dev/null; then d=-c; else d='-M -m --first-parent'; fi
    git -c core.quotePath=false diff-tree -r -z --root $d --no-commit-id "$c" >/dev/null 2>&1 || { echo "Push blocked: the changes of $c cannot be read, so a test change in it cannot be ruled out." >&2; exit 1; }
    hit=$(git -c core.quotePath=false diff-tree -r -z --root $d --no-commit-id --name-status "$c" | tr '\0' '\n' | awk '
      function istest(p,   q) { q = tolower(p); return q ~ /(^|\/)(test|tests|__tests__|spec)\// || q ~ /\.(test|spec)\.[^\/]*$/ }
      { if (need == 0) { st = $0; need = st ~ /^[RC]/ ? 2 : 1 } else { if (st !~ /^A+$/ && istest($0)) held = 1; need-- } }
      END { if (held) print 1 }')
    if [ -n "$hit" ] || git log -1 --format=%s "$c" | grep -Eiq '^(fixup! |squash! )?retest(\([^)]*\))?!?:'; then
      retests="$retests$(git log -1 --format='%h %s' "$c")
"
    fi
  done
done <<EOF
$refs
EOF
if [ -n "$retests" ]; then
  # F4 (owner ruling): the owner's own push lifts the hold when the owner tapped Yes on a pop-up quoting the push. It is
  # read as project/.githooks/pre-push reads it: the same owner-yes.cjs, one check per ref, with the kind it reads.
  yes="$(dirname "$0")/../project/.claude/owner-yes.cjs"
  common=$(git rev-parse --git-common-dir)
  owned=1
  if [ "$KIT_OWNER_PUSH" = "1" ]; then
    [ -z "$AI_AGENT$CLAUDECODE" ] && [ -n "$CLAUDE_CODE_SESSION_ID" ] && [ -f "$yes" ] || owned=0
  else
    [ "$KIT_PUSH_APPROVED" = "1" ] && [ -n "$CLAUDE_CODE_SESSION_ID" ] && [ -f "$yes" ] || owned=0
  fi
  while read -r lref lsha rref rsha; do
    [ -n "$rref" ] || continue
    [ "$owned" = 1 ] || break
    kind=""
    case "$lsha" in *[!0]*) ;; *) kind=delete ;; esac
    case "$rsha" in *[!0]*)
      [ -z "$kind" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null && kind=force ;;
    esac
    node "$yes" --push "$rref" "$kind" "$common" "$1" 10 || owned=0
  done <<EOF
$refs
EOF
  if [ "$owned" != 1 ]; then
    echo "Push blocked: this push holds a test change, a retest: commit or an edit, delete or rename of a test file (named below). The owner's yes is needed for it: after the owner's pop-up yes, run the push with KIT_PUSH_APPROVED=1, or the owner pushes it from their own terminal." >&2
    printf '%s' "$retests" >&2
    exit 1
  fi
fi
common=$(git rev-parse --git-common-dir)
gatelog="$common/kit-merge-gate.log"
if [ -f "$gatelog" ]; then
  while read -r lref lsha rref rsha; do
    case "$rsha" in *[!0]*) ;; *) continue ;; esac
    pr=$(awk -v sha="$rsha" '$2=="ARMED" && $4==sha { n=$3; sub(/.*\//,"",n); armed[n]=1 } $2=="DISARMED" { delete armed[$3] } END { s=""; for (n in armed) { printf "%s%s", s, n; s=" " } }' "$gatelog")
    if [ -n "$pr" ]; then
      echo "Push blocked: PR $pr is armed at this head. Run node ~/.claude/kit-tools/merge-gate.mjs disarm $pr first, then the gate again after the push." >&2
      exit 1
    fi
  done <<EOF
$refs
EOF
fi
exit 0
