#!/bin/sh
# Pushes are the owner's (rule:outward-acts), with one bound the owner set (T1, 2026-11-10): an AI tool (its shell
# marked AI_AGENT, or CLAUDECODE for Claude Code) may push a feature branch without a yes. Anything else from an AI
# tool - main, master, the remote's default branch, a tag, a delete, a force push - needs the owner's go, after which
# the agent runs the push with KIT_PUSH_APPROVED=1 (Claude Code's guard lets that through only on the owner's pop-up
# yes). Every AI push is scanned for secrets, commit by commit, and logged. The owner's own terminal is left alone.
# Git gives the refs being pushed on stdin once; keep them for every check below.
refs=$(cat)
if [ -n "$AI_AGENT$CLAUDECODE" ]; then
  common=$(git rev-parse --git-common-dir)
  if [ "$KIT_PUSH_APPROVED" != "1" ]; then
    default=$(git symbolic-ref --short "refs/remotes/$1/HEAD" 2>/dev/null)
    default=${default#"$1"/}
    sent=0
    while read -r lref lsha rref rsha; do
      [ -n "$lref" ] || continue
      sent=1
      why=""
      case "$lsha" in *[!0]*) ;; *) why="a delete" ;; esac
      case "$rref" in refs/heads/*) ;; *) why="${why:-not a branch}" ;; esac
      branch=${rref#refs/heads/}
      case "$branch" in main|master) why="${why:-the main branch}" ;; esac
      if [ -n "$default" ] && [ "$branch" = "$default" ]; then why="${why:-the default branch}"; fi
      case "$rsha" in *[!0]*)
        git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null || why="${why:-a force push}" ;;
      esac
      if [ -n "$why" ]; then
        echo "Push blocked: an AI agent may push only a feature branch without the owner's go ($rref: $why). Ask the owner; after a yes, run the push with KIT_PUSH_APPROVED=1." >&2
        exit 1
      fi
    done <<EOF
$refs
EOF
    if [ "$sent" = 0 ]; then
      echo "Push blocked: an AI agent is pushing without the owner's go. Ask the owner; after a yes, run the push with KIT_PUSH_APPROVED=1." >&2
      exit 1
    fi
  else
    # The marker is a variable any script can set, so it counts only beside the owner's own pop-up yes, in this
    # session's transcript, to a push that names each ref (T1).
    yes="$(dirname "$0")/../.claude/owner-yes.cjs"
    while read -r lref lsha rref rsha; do
      [ -n "$rref" ] || continue
      kind=""
      case "$lsha" in *[!0]*) ;; *) kind=delete ;; esac
      case "$rsha" in *[!0]*)
        [ -z "$kind" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null && kind=force ;;
      esac
      if [ ! -f "$yes" ] || ! node "$yes" --push "$rref" "$kind"; then
        echo "Push blocked: KIT_PUSH_APPROVED is set, but this session holds no fresh pop-up yes from the owner to a push naming $rref. Ask the owner with the pop-up first." >&2
        exit 1
      fi
    done <<EOF
$refs
EOF
  fi
  scan="$(dirname "$0")/../.claude/secret-shapes.mjs"
  if [ ! -f "$scan" ]; then
    echo "Push blocked: the secret scan (.claude/secret-shapes.mjs) is missing; reinstall the kit." >&2
    exit 1
  fi
  printf '%s\n' "$refs" | node "$scan" --push || { echo "Push blocked: a secret-shaped file or value is in a pushed commit. Take it out of the history, and rotate any real key." >&2; exit 1; }
fi
# Branch names in the house style (rule:branching): every branch this push sends.
names="$(dirname "$0")/../.claude/name-check.mjs"
if [ -f "$names" ]; then
  for rref in $(printf "%s
" "$refs" | awk '{print $3}'); do
    case "$rref" in refs/heads/*) node "$names" branch "${rref#refs/heads/}" || exit 1 ;; esac
  done
fi
# The first push gate (rule:first-push-gate), for any pusher whose git runs this hook: until the project's first push
# has landed, only the commit .claude/first-push-check.mjs cleared (or one of its ancestors, or a tag of it) may go
# out. The gate is done once that commit is on a remote branch, or once every first (root) commit being pushed is
# already on a remote (the project was pushed before the kit came; the install leaves a done mark for that too). A
# branch the host made on its own (a README) does not end it: its root is not ours.
common=$(git rev-parse --git-common-dir)
if [ ! -f "$common/kit-first-push-done" ]; then
  checked=$(cat "$common/kit-first-push-ok" 2>/dev/null)
  if [ -n "$checked" ] && [ -n "$(git branch -r --contains "$checked" 2>/dev/null)" ]; then
    : > "$common/kit-first-push-done"
  else
    while read -r lref lsha rref rsha; do
      case "$lsha" in *[!0]*) ;; *) continue ;; esac
      commit=$(git rev-parse -q --verify "$lsha^{commit}")
      if [ -n "$commit" ] && [ -n "$(git for-each-ref --count=1 refs/remotes/)" ] && [ -z "$(git rev-list --max-parents=0 "$commit" --not --remotes)" ]; then
        : > "$common/kit-first-push-done"
        continue
      fi
      if [ -z "$checked" ] || [ -z "$commit" ] || ! git merge-base --is-ancestor "$commit" "$checked"; then
        echo "First push blocked (rule:first-push-gate): run node .claude/first-push-check.mjs, fix what it finds, then push the commit it cleared." >&2
        exit 1
      fi
    done <<EOF
$refs
EOF
  fi
fi
# GitHub documents no head pin past a writer's push, so a push over a head still armed stops here (rule:standing-grants).
gatelog="$common/kit-merge-gate.log"
if [ -f "$gatelog" ]; then
  while read -r lref lsha rref rsha; do
    case "$rsha" in *[!0]*) ;; *) continue ;; esac
    pr=$(awk -v sha="$rsha" '$2=="ARMED" && $4==sha { n=$3; sub(/.*\//,"",n); armed[n]=1 } $2=="DISARMED" { delete armed[$3] } END { s=""; for (n in armed) { printf "%s%s", s, n; s=" " } }' "$gatelog")
    if [ -n "$pr" ]; then
      echo "Push blocked: PR $pr is armed at this head. Run node ~/.claude/kit-tools/merge-gate.mjs disarm $pr first, then the gate again after the push." >&2
      exit 1
    fi
  done <<EOF
$refs
EOF
fi
# Every check passed: an AI push is logged (time, auto or owner, ref, commit), the record the owner reads after.
if [ -n "$AI_AGENT$CLAUDECODE" ]; then
  how=auto
  [ "$KIT_PUSH_APPROVED" = "1" ] && how=owner
  printf '%s\n' "$refs" | awk -v t="$(date -u +%Y-%m-%dT%H:%M:%SZ)" -v h="$how" 'NF { print t, h, $3, $2 }' >> "$common/kit-push.log" 2>/dev/null
fi
exit 0
