#!/bin/sh
# Feature-branch pushes go without a yes (rule:outward-acts). Every push is scanned for secrets and logged;
# KIT_OWNER_PUSH=1 passes the bound only.
# The refs being pushed, from stdin.
refs=$(cat)
# Branch names (rule:branching).
names="$(dirname "$0")/../.claude/name-check.mjs"
if [ -f "$names" ]; then
  for rref in $(printf "%s
" "$refs" | awk '{print $3}'); do
    case "$rref" in refs/heads/*) node "$names" branch "${rref#refs/heads/}" || exit 1 ;; esac
  done
fi
OWNER_WAY="The owner's own push from their own terminal has its own way (rule:outward-acts)."
# A url.insteadOf rewrite of the push URL would send every ls-remote to a decoy: refused, whoever runs it. Keys and
# values are read NUL-split, so a value with spaces counts whole, and an empty one matches every URL.
if git config -z --get-regexp '^url\..*\.insteadof$' 2>/dev/null | KIT_URL="$2" node -e 'let s="";process.stdin.on("data",(d)=>{s+=d;}).on("end",()=>{process.exit(s.split("\0").some((r)=>{const n=r.indexOf("\n");const v=r.slice(n+1);return n>=0&&process.env.KIT_URL.startsWith(v);})?0:1);})'; then
  echo "Push blocked: a url.insteadOf setting rewrites $2, so the hook cannot ask the real remote what it holds. Push to the remote's own URL with that setting out of the way." >&2
  exit 1
fi
# The remote's default branch, asked of the remote by URL (a local origin/HEAD is any command's to move). With branches
# there and no default line, it prints ?.
remote_default() {
  if out=$(git ls-remote --symref "$2" HEAD 2>/dev/null); then
    d=$(printf '%s\n' "$out" | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$|\1|p' | head -n 1)
    # Named none: origin/HEAD is not asked, since a tool can move it. A new repo has no default yet.
    if [ -z "$d" ] && [ -n "$(git ls-remote --heads "$2" 2>/dev/null)" ]; then d="?"; fi
  else
    # Cannot be asked: it may be the default branch, so ?.
    d="?"
  fi
  printf '%s\n' "$d"
}
# Two pushes on one yes would race. A lock over 10 minutes old, whose owner (pid and nonce) is gone, is taken over;
# only its owner removes it.
lock_me="$$ $(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
take_lock() {
  l="$common/kit-push.lock"
  if mkdir "$l" 2>/dev/null; then printf '%s\n' "$lock_me" > "$l/owner"; return 0; fi
  if [ -n "$(find "$l" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    pid=$(cut -d' ' -f1 "$l/owner" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) pid="" ;; esac
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
      if mv "$l" "$l.stale.$$" 2>/dev/null && mkdir "$l" 2>/dev/null; then
        rm -rf "$l.stale.$$"
        printf '%s\n' "$lock_me" > "$l/owner"
        return 0
      fi
    fi
  fi
  echo "Push blocked: another push on the owner's yes is running ($common/kit-push.lock). Wait for it; a stale lock is taken over." >&2
  return 1
}
drop_lock() {
  [ "$(cat "$common/kit-push.lock/owner" 2>/dev/null)" = "$lock_me" ] && rm -rf "$common/kit-push.lock"
}
# A test change needs the owner's yes; the helper names each test path and retest. An unreadable history is held too,
# and no yes lifts that.
scan_tests="$(dirname "$0")/../.claude/test-push-scan.mjs"
if [ ! -f "$scan_tests" ]; then
  echo "Push blocked: the test-change scan (.claude/test-push-scan.mjs) is missing; reinstall the kit." >&2
  exit 1
fi
retests=""
held=$(printf '%s\n' "$refs" | node "$scan_tests" "$2"); scan_rc=$?
case "$scan_rc" in
  0) ;;
  10) if printf '%s\n' "$held" | grep -Eq '^  [0-9a-f]{7} '; then retests=$held; else echo "Push blocked: the test-change scan gave no result, so the push is held." >&2; exit 1; fi ;;
  *) printf '%s\n' "${held:-Push blocked: the test-change scan did not finish (exit $scan_rc), so the push is held.}" >&2; exit 1 ;;
esac
if [ -n "$retests" ] && [ "$KIT_OWNER_PUSH" != "1" ] && [ "$KIT_PUSH_APPROVED" != "1" ]; then
  printf '%s\n' "$retests" >&2
  exit 1
fi
# The push bound and the secret scan, for every pusher.
{
  common=$(git rev-parse --git-common-dir)
  # The owner's marker is a variable a run-time-built name could set past the guard, so it counts only in a shell with
  # neither AI marker; the guard holds a command that clears those.
  if [ "$KIT_OWNER_PUSH" = "1" ] && [ -n "$AI_AGENT$CLAUDECODE" ]; then
    echo "Push blocked: KIT_OWNER_PUSH is the owner's own, from their own terminal; this shell is an AI's. Ask the owner; after a yes, run the push with KIT_PUSH_APPROVED=1." >&2
    exit 1
  elif [ "$KIT_OWNER_PUSH" = "1" ]; then
    # The marker alone is no owner: a script can clear both markers. The owner's push passes the bound only beside a
    # fresh pop-up yes naming each ref; the checks below still run.
    yes="$(dirname "$0")/../.claude/owner-yes.cjs"
    take_lock || exit 1
    trap drop_lock EXIT
    while read -r lref lsha rref rsha; do
      [ -n "$rref" ] || continue
      kind=""
      case "$lsha" in *[!0]*) ;; *) kind=delete ;; esac
      case "$rsha" in *[!0]*)
        [ -z "$kind" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null && kind=force ;;
      esac
      if [ -z "$CLAUDE_CODE_SESSION_ID" ]; then
        # No session: the owner types the ref's name at their own terminal.
        short=${rref#refs/heads/}
        short=${short#refs/tags/}
        if ! (exec 3<>/dev/tty) 2>/dev/null; then
          echo "Push blocked: KIT_OWNER_PUSH with no Claude session asks the owner to type the ref's name at their own terminal, and this shell has none. Run the push in your own terminal." >&2
          exit 1
        fi
        exec 3<>/dev/tty
        printf 'KIT_OWNER_PUSH: type %s%s to push it past the bound: ' "${kind:+$kind }" "$short" >&3
        IFS= read -r typed <&3 || typed=""
        exec 3<&-
        if [ "$typed" != "${kind:+$kind }$short" ]; then
          echo "Push blocked: the name typed was not ${kind:+$kind }$short." >&2
          exit 1
        fi
      elif [ ! -f "$yes" ] || ! node "$yes" --push "$rref" "$kind" "$common" "$1" 10; then
        echo "Push blocked: KIT_OWNER_PUSH counts only beside the owner's pop-up yes, at most 10 minutes old, to a push to $1 naming $rref. Answer Yes in that session's pop-up first, or push from your own terminal with no session." >&2
        exit 1
      fi
    done <<EOF
$refs
EOF
  elif [ "$KIT_PUSH_APPROVED" != "1" ]; then
    default=$(remote_default "$1" "$2")
    sent=0
    while read -r lref lsha rref rsha; do
      [ -n "$lref" ] || continue
      sent=1
      why=""
      case "$lsha" in *[!0]*) ;; *) why="a delete" ;; esac
      case "$rref" in refs/heads/*) ;; *) why="${why:-not a branch}" ;; esac
      branch=${rref#refs/heads/}
      case "$branch" in main|master) why="${why:-the main branch}" ;; esac
      if [ -n "$default" ] && [ "$branch" = "$default" ]; then why="${why:-the default branch}"; fi
      if [ "$default" = "?" ]; then why="${why:-the remote names no default branch, so this may be it}"; fi
      # A remote with no branch yet makes the first one pushed its default.
      if [ -z "$default" ]; then why="${why:-the remote has no branch yet, so this push sets its default}"; fi
      case "$rsha" in *[!0]*)
        git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null || why="${why:-a force push}" ;;
      esac
      if [ -n "$why" ]; then
        echo "Push blocked: only a feature branch goes without the owner's yes ($rref: $why). Ask the owner; after a yes, run the push with KIT_PUSH_APPROVED=1. $OWNER_WAY" >&2
        exit 1
      fi
    done <<EOF
$refs
EOF
    if [ "$sent" = 0 ]; then
      echo "Push blocked: a push that names no ref goes only with the owner's yes. Ask the owner; after a yes, run the push with KIT_PUSH_APPROVED=1. $OWNER_WAY" >&2
      exit 1
    fi
  else
    # A script can set the marker, so the pop-up yes is needed too.
    yes="$(dirname "$0")/../.claude/owner-yes.cjs"
    # The lock holds from the yes check to the log line that spends the yes.
    take_lock || exit 1
    trap drop_lock EXIT
    default=$(remote_default "$1" "$2")
    # A new repo's remote has no branch at all, asked of the remote; a remote that cannot be asked is not taken as new.
    heads=$(git ls-remote --heads "$2" 2>/dev/null) || heads="unknown"
    while read -r lref lsha rref rsha; do
      [ -n "$rref" ] || continue
      case "${rref#refs/heads/}" in main|master)
        case "$rsha" in *[!0]*) ;; *)
          if [ -n "$heads" ]; then
            echo "Push blocked: ${rref#refs/heads/} takes a PR. A yes pushes to main only as a new repo's first push, and this remote is not new (it has branches, or could not be asked); open a PR instead." >&2
            exit 1
          fi ;;
        esac ;;
      esac
      # An AI pushes to main only as a new repo's first push: rsha is zero when the remote has no such branch yet.
      branch=${rref#refs/heads/}
      case "$rsha" in *[!0]*)
        case "$branch" in main|master)
          echo "Push blocked: $branch takes a PR. A yes pushes to main only as a new repo's first push, and this remote already has $branch; open a PR instead." >&2
          exit 1 ;;
        esac
        if [ -n "$default" ] && [ "$branch" = "$default" ]; then
          echo "Push blocked: $branch is the remote's default branch and takes a PR; open a PR instead." >&2
          exit 1
        fi ;;
      esac
      kind=""
      case "$lsha" in *[!0]*) ;; *) kind=delete ;; esac
      case "$rsha" in *[!0]*)
        [ -z "$kind" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null && kind=force ;;
      esac
      if [ ! -f "$yes" ] || ! node "$yes" --push "$rref" "$kind" "$common" "$1"; then
        echo "Push blocked: KIT_PUSH_APPROVED is set, but this session holds no fresh pop-up yes from the owner to a push naming $rref. Ask the owner with the pop-up first. $OWNER_WAY" >&2
        if [ -n "$retests" ]; then printf '%s\n' "$retests" >&2; fi
        exit 1
      fi
    done <<EOF
$refs
EOF
  fi
  scan="$(dirname "$0")/../.claude/secret-shapes.mjs"
  if [ ! -f "$scan" ]; then
    echo "Push blocked: the secret scan (.claude/secret-shapes.mjs) is missing; reinstall the kit." >&2
    exit 1
  fi
  printf '%s\n' "$refs" | node "$scan" --push "$2" || { echo "Push blocked: a secret-shaped file or value is in a pushed commit. Take it out of the history, and rotate any real key." >&2; exit 1; }
}
# The first push gate: until the first push lands, only the commit .claude/first-push-check.mjs
# cleared (or its ancestor) may go out. It ends once that commit is on a remote, or every root commit pushed is already.
common=$(git rev-parse --git-common-dir)
if [ ! -f "$common/kit-first-push-done" ]; then
  checked=$(cat "$common/kit-first-push-ok" 2>/dev/null)
  if [ -n "$checked" ] && [ -n "$(git branch -r --contains "$checked" 2>/dev/null)" ]; then
    : > "$common/kit-first-push-done"
  else
    # Asked of the remote: a local remote-tracking ref can be faked.
    have=$(git ls-remote "$2" 2>/dev/null | while read -r sha ref; do git cat-file -e "$sha^{commit}" 2>/dev/null && printf '%s\n' "$sha"; done)
    while read -r lref lsha rref rsha; do
      case "$lsha" in *[!0]*) ;; *) continue ;; esac
      commit=$(git rev-parse -q --verify "$lsha^{commit}")
      # shellcheck disable=SC2086
      if [ -n "$commit" ] && [ -n "$have" ] && [ -z "$(git rev-list --max-parents=0 "$commit" --not $have)" ]; then
        : > "$common/kit-first-push-done"
        continue
      fi
      if [ -z "$checked" ] || [ -z "$commit" ] || ! git merge-base --is-ancestor "$commit" "$checked"; then
        echo "First push blocked (rule:first-push-gate): run node .claude/first-push-check.mjs, fix what it finds, then push the commit it cleared." >&2
        exit 1
      fi
    done <<EOF
$refs
EOF
  fi
fi
# A head still armed for a PR stops the push (rule:standing-grants).
gatelog="$common/kit-merge-gate.log"
if [ -f "$gatelog" ]; then
  while read -r lref lsha rref rsha; do
    case "$rsha" in *[!0]*) ;; *) continue ;; esac
    pr=$(awk -v sha="$rsha" '$2=="ARMED" && $4==sha { n=$3; sub(/.*\//,"",n); armed[n]=1 } $2=="DISARMED" { delete armed[$3] } END { s=""; for (n in armed) { printf "%s%s", s, n; s=" " } }' "$gatelog")
    if [ -n "$pr" ]; then
      echo "Push blocked: PR $pr is armed at this head. Run merge-gate.mjs disarm $pr first (the start-up line \"Kit tools this session\" has its command), then the gate again after the push." >&2
      exit 1
    fi
  done <<EOF
$refs
EOF
fi
# Logged last: an owner push the log cannot record does not go.
{
  how=auto
  [ "$KIT_PUSH_APPROVED" = "1" ] && how=owner
  [ "$KIT_OWNER_PUSH" = "1" ] && how=owner-hand
  if ! printf '%s\n' "$refs" | awk -v t="$(node -e 'console.log(new Date().toISOString())')" -v h="$how" 'NF { print t, h, $3, $2 }' >> "$common/kit-push.log" 2>/dev/null; then
    if [ "$how" = owner ] || [ "$how" = owner-hand ]; then
      echo "Push blocked: the push log ($common/kit-push.log) cannot be written, so the owner's yes cannot be spent." >&2
      exit 1
    fi
  fi
}
exit 0
