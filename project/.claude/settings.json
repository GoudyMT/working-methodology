{
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "npm_config_yes": "false"
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --list*)",
      "Bash(git rev-parse*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem*)"
    ],
    "deny": [
      "Edit(**/.claude/*.cjs)",
      "Edit(**/.claude/*.mjs)",
      "Edit(**/.githooks/**)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Bash(git config core.hooksPath *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)",
      "PowerShell(git config core.hooksPath *)",
      "PowerShell(git commit --no-verify *)",
      "PowerShell(git push --no-verify *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/guard.cjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "session-start"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "pre-compact"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
