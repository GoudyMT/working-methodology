{
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "npm_config_yes": "false"
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/owner-proof.cjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/guard-outward.cjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/guard-delete.cjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/kit-hooks/call-cap.cjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/kit-hooks/canary.cjs"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/kit-hooks/sweep-guard.cjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "session-start"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "pre-compact"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
