{
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "npm_config_yes": "false"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse *)",
      "Bash(git branch --list)",
      "Bash(git branch --list *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git show)",
      "PowerShell(git show *)",
      "PowerShell(Get-ChildItem)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)"
    ],
    "deny": [
      "Edit(**/.claude/*.cjs)",
      "Edit(**/.claude/*.mjs)",
      "Edit(**/.githooks/**)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Bash(git config core.hooksPath *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)",
      "Bash(git log --output*)",
      "Bash(git diff --output*)",
      "Bash(git show --output*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(git show *--output*)",
      "PowerShell(git log --output*)",
      "PowerShell(git diff --output*)",
      "PowerShell(git show --output*)",
      "PowerShell(git log *--output*)",
      "PowerShell(git diff *--output*)",
      "PowerShell(git show *--output*)",
      "PowerShell(git config core.hooksPath *)",
      "PowerShell(git commit --no-verify *)",
      "PowerShell(git push --no-verify *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "session-start"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "pre-compact"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{PROJECT_DIR}}/.claude/kit-hook.cjs",
              "prompt"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
